PHONOTEKA_IMAGE=ghcr.io/nd4y/phonoteka@sha256:REPLACE_WITH_TESTED_DIGEST
APP_URL=https://phonoteka.example.net
PUID=10001
PGID=10001
INSTANCE_ID=choose-a-unique-instance-id
STATE_PATH=/srv/phonoteka/state
WORK_PATH=/srv/music-work
ORIGINAL_PATH=/srv/music-original
PUBLICATION_PATH=/srv/music-publication
GUARD_PATH=/srv/phonoteka/storage-guard
PASSWORD_FILE=/srv/phonoteka/secrets/owner_password
OWNER_USERNAME=owner
READ_ONLY=true
STORAGE_VERIFIED=false
FILE_WORKERS=2
IO_THREADS=2
LOG_LEVEL=INFO
METRICS_TOKEN_FILE=/srv/phonoteka/secrets/metrics_token
EXTERNAL_METADATA=false
PROVIDER_DAILY_LIMIT=2500
INFERENCE_URL=http://inference:8001
INFERENCE_KEY_FILE=/srv/phonoteka/secrets/inference_key
INFERENCE_STATE_PATH=/srv/phonoteka/inference
PHONOTEKA_INFERENCE_IMAGE=ghcr.io/nd4y/phonoteka-inference@sha256:REPLACE_WITH_TESTED_DIGEST
# Optional compose.pc2-asr.yaml overlay. Keep the key readable only by PUID.
PC2_ASR_URL=https://asr-pc2.example.internal/v1/whisper
PC2_ASR_KEY_FILE=/srv/phonoteka/secrets/pc2_asr_key

# Optional official beta endpoint; same live database, prerelease server code.
MUSICBRAINZ_HOST=musicbrainz.org

# Explicit opt-in: locally generated 12-second fingerprints sent to Shazam.
EXTERNAL_FINGERPRINTS=false
YOUTUBE_ENABLED=false

# Additional metadata destinations: opt-in, disabled by default.
THEAUDIODB_ENABLED=false
THEAUDIODB_ARTWORK=false
DISCOGS_ENABLED=false
# Mount a protected token file through a local compose override before enabling.
# DISCOGS_TOKEN_FILE=/run/secrets/discogs_token
